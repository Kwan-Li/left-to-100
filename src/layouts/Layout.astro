---
import '../styles/global.css';
import emblem from '../brand/emblem.svg?raw';
import { data } from '../data';
import { SITE, href } from '../site';

interface Props {
  title: string;
  description: string;
  /** JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  active?: 'home' | 'cards' | 'missables' | 'data';
}

const { title, description, schema = [], active } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(href('/og.png'), Astro.site).toString();
/** The same emblem art as the favicon and OG image, sized for the header. */
const brandMark = emblem.replace('<svg ', '<svg width="30" height="30" aria-hidden="true" focusable="false" ');
/** Wordmark pieces ("Left", "To", "100"), spaced apart in CSS; the link text still reads as the one name. */
const word = SITE.name.match(/^([A-Z][a-z]+)([A-Z][a-z]+)(\d+)$/)?.slice(1) ?? [SITE.name];
/** Self-hosted fonts (public/fonts, also precached by sw.js). Latin subsets; Martian Mono is one variable file. */
const fonts = [
  // Michroma's "%" reads as "o/o" at display sizes, so "%" falls through to Barlow (next in --display).
  {
    family: 'Michroma',
    file: 'michroma.woff2',
    weight: '400',
    preload: true,
    range: 'U+0000-0024,U+0026-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2212',
  },
  { family: 'Barlow', file: 'barlow-500.woff2', weight: '500', preload: true },
  { family: 'Barlow', file: 'barlow-600.woff2', weight: '600', preload: true },
  { family: 'Barlow', file: 'barlow-700.woff2', weight: '700', preload: false },
  { family: 'Martian Mono', file: 'martian-mono.woff2', weight: '100 800', preload: true },
];
const fontFaces = fonts
  .map(
    (f) =>
      `@font-face{font-family:'${f.family}';font-style:normal;font-weight:${f.weight};font-display:swap;src:url('${href(`/fonts/${f.file}`)}') format('woff2');${'range' in f ? `unicode-range:${f.range};` : ''}}`,
  )
  .join('');
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

const nav = [
  { id: 'home', label: '100% calculator', path: '/' },
  { id: 'cards', label: 'Card sets', path: '/card-sets/' },
  { id: 'missables', label: 'Missables', path: '/missables/' },
  { id: 'data', label: 'Open data', path: '/data/' },
] as const;

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: new URL(href('/'), Astro.site).toString(),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#0a0b0b" />
    <meta name="color-scheme" content="dark" />
    {fonts.filter((f) => f.preload).map((f) => <link rel="preload" href={href(`/fonts/${f.file}`)} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={fontFaces} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={href("/favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={href('/icon-192.png')} />
    <link rel="manifest" href={href('/manifest.webmanifest')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(website)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={href('/')}>
          <span class="brand-mark" set:html={brandMark} />
          <span class="brand-word">{word.map((w, i) => (i === word.length - 1 && /^\d+$/.test(w) ? <b>{w}</b> : <span>{w}</span>))}</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li>
                <a href={href(n.path)} aria-current={active === n.id ? 'page' : undefined}>{n.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <script is:inline>
          // Phones: the nav is a sideways strip. Before first paint, scroll it (sideways only, never the page) so the
          // current page's link is in view, centered where possible, then fade only the edges that hide more links.
          // The web fonts change the link widths after first paint, so it's done again once they load (unless the
          // strip was scrolled in between). Scroll, resize and keyboard-focus handling come from edgeFades() below.
          (() => {
            const nav = document.querySelector('.site-header nav');
            if (!nav) return;
            const place = () => {
              const cur = nav.querySelector('a[aria-current="page"]');
              if (cur && nav.scrollWidth > nav.clientWidth) {
                const n = nav.getBoundingClientRect();
                const c = cur.getBoundingClientRect();
                nav.scrollLeft += c.left + c.width / 2 - (n.left + n.width / 2);
              }
              // Same toggles as edgeFades() `update` (src/lib/edgeFades.ts).
              nav.classList.toggle('fade-l', nav.scrollLeft > 1);
              nav.classList.toggle('fade-r', nav.scrollWidth - nav.clientWidth - nav.scrollLeft > 1);
              return nav.scrollLeft;
            };
            const at = place();
            document.fonts?.ready.then(() => {
              if (Math.abs(nav.scrollLeft - at) < 1) place();
            });
          })();
        </script>
        <script>
          import { edgeFades } from '../lib/edgeFades';
          const nav = document.querySelector<HTMLElement>('.site-header nav');
          if (nav) edgeFades(nav);
        </script>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-brand">
          <span class="brand-mark" set:html={brandMark} />
          <span class="brand-word">{word.map((w, i) => (i === word.length - 1 && /^\d+$/.test(w) ? <b>{w}</b> : <span>{w}</span>))}</span>
        </p>
        <p>
          Data version <code>{data.version}</code>, updated {data.updated}. Numbers come from public guides and player reports;
          treat unverified figures as provisional. <a href={href('/data/')}>See sources and status</a>.
        </p>
        <p>
          Free and open source (MIT code, CC0 data). <a href={`${SITE.repo}/issues/new?template=correction.yml`}>Report a correction on GitHub</a>.
        </p>
        <p class="muted">{SITE.disclaimer}</p>
      </div>
    </footer>
    <script>
      if ('serviceWorker' in navigator && location.protocol === 'https:') {
        navigator.serviceWorker.register(`${import.meta.env.BASE_URL}sw.js`).catch(() => {});
      }
    </script>
  </body>
</html>
