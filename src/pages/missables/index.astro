---
import DontLose from '../../components/DontLose';
import { StatusBadge } from '../../components/StatusBadge';
import { data } from '../../data';
import Layout from '../../layouts/Layout.astro';
import { href } from '../../site';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const chapters = [...data.chapters].sort((a, b) => a.order - b.order);
const reqName = (id: string) => data.requirements.find((r) => r.id === id)?.name ?? id;

const faqs = [
  {
    q: 'Is anything missable for 100% in GTA 6?',
    a: `A few items are reported to become unavailable after certain chapters (${data.missables.length} tracked here). Because most requirements only need part of the total, missing one usually eats into your room to skip rather than blocking 100%.`,
  },
  {
    q: 'Can you replay missions in GTA 6?',
    a: 'Early guides report no mission replay, so keeping a separate manual save before finishing each chapter is the safest habit.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '100% calculator', item: new URL(href('/'), Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Missables', item: pageUrl },
    ],
  },
];
---

<Layout
  title="GTA 6 100% Missables by Chapter (Spoiler-Safe)"
  description="GTA 6 missables that affect 100%, one chapter at a time with no plot spoilers. See only what you could lose next and when to keep a backup save."
  schema={schema}
  active="missables"
>
  <div class="page-head">
    <h1>GTA 6 missables <span class="accent">that affect 100%</span></h1>
    <p class="lead">
      Pick your chapter to see only what you can lose at the end of it. No plot details, no mission names, and nothing from
      later chapters.
    </p>
  </div>

  <DontLose client:load showPicker />

  <h2 id="full-list">Full list by chapter</h2>
  <div class="callout spoiler">
    Spoiler warning: this full list names chapters and locations for every tracked missable. Open only the chapters you've
    already reached.
  </div>
  {
    chapters.map((c) => {
      const items = data.missables.filter((m) => m.lostAfterChapterId === c.id);
      const ponr = data.pointsOfNoReturn.filter((p) => p.chapterId === c.id);
      if (!items.length && !ponr.length) return null;
      return (
        <details class="faq">
          <summary>
            {items.length > 0
              ? `End of ${c.label} (${items.length} ${items.length === 1 ? 'missable' : 'missables'})`
              : `End of ${c.label} (save point note)`}
          </summary>
          <ul>
            {ponr.map((p) => (
              <li>
                <strong>Point of no return:</strong> {p.label} <StatusBadge status={p.status} />
              </li>
            ))}
            {items.map((m) => (
              <li>
                <strong>{m.label}</strong> ({reqName(m.requirementId)}): {m.where} {m.effect} <StatusBadge status={m.status} />
              </li>
            ))}
          </ul>
        </details>
      );
    })
  }

  <h2 id="faq">Missables FAQ</h2>
  {
    faqs.map((f) => (
      <details class="faq">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</Layout>
