---
import Planner from '../components/Planner';
import DontLose from '../components/DontLose';
import { StatusBadge } from '../components/StatusBadge';
import { data, minimumCards } from '../data';
import Layout from '../layouts/Layout.astro';
import { r1 } from '../copy/r1';
import { SITE, href } from '../site';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
// "LeftTo100" -> ["Left", "To", "100"]: the big hero lockup, with the number on its own line.
const word = SITE.name.match(/^([A-Z][a-z]+)([A-Z][a-z]+)(\d+)$/)?.slice(1) ?? [SITE.name];
const flamingos = data.requirements.find((r) => /flamingo/i.test(r.name));
const stunts = data.requirements.find((r) => /stunt/i.test(r.name));
const fmt = (unit: string, n: number) => (unit === 'dollars' ? `$${n.toLocaleString('en-US')}` : unit === 'percent' ? `${n}%` : n.toLocaleString('en-US'));

const examples = [
  `${data.totals.cardSetsRequired} of ${data.totals.cardSets} card sets`,
  flamingos && flamingos.total ? `${flamingos.required} of ${flamingos.total} ${flamingos.name.toLowerCase()}` : null,
  stunts && stunts.total ? `${stunts.required} of ${stunts.total} stunts` : null,
].filter(Boolean);

const faqs = [
  {
    q: 'When does the 100% checklist unlock in GTA 6?',
    a: `The in-game 100% Completion list (Progress > Stats) only unlocks after you finish the main story. Everything you do before then still counts—you just can't see the checklist yet, which is why ${SITE.name} exists.`,
  },
  {
    q: 'How many requirements are on the GTA 6 100% checklist?',
    a: `${data.totals.requirements} in total, grouped into ${data.categories.map((c) => c.name).join(', ')}.`,
  },
  {
    q: 'Do I need every collectible for 100%?',
    a: `No. Most requirements only ask for part of the total—for example, ${examples.join(', ')}. Each row in the calculator shows how many you can skip.`,
  },
  {
    q: 'What is the minimum number of collectible cards needed for 100%?',
    a: `${minimumCards} of ${data.totals.cards}, if you finish the ${data.totals.cardSetsRequired} smallest sets from scratch. Your actual minimum depends on which sets you've already started—the card set planner works it out for you.`,
  },
  {
    q: 'Can I miss anything that counts toward 100%?',
    a: 'A few items are reported to become unavailable after certain chapters. None are reported to block 100% on their own, but missing them eats into your room to skip. The "Before you finish" panel warns you only about your current chapter, with no plot details.',
  },
  {
    q: 'Is this an official Rockstar tool?',
    a: `No. ${SITE.name} is an unofficial, free, open-source fan project. Every fact links to its public sources and is marked verified, reported, or disputed.`,
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${SITE.name}: GTA 6 100% Completion Calculator`,
    url: pageUrl,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any (web browser)',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: `Enter your GTA 6 Progress menu counts to see what's left for all ${data.totals.requirements} 100% requirements, how many you can skip, and which card sets to finish.`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Layout
  title="GTA 6 100% Completion Calculator & Checklist"
  description={`Free, spoiler-safe GTA 6 100% completion calculator. See all ${data.totals.requirements} requirements early, what you can skip, and which card sets to finish.`}
  schema={schema}
  active="home"
>
  <Planner client:load pageUrl={pageUrl}>
    <p class="hero-mark" aria-hidden="true">
      {word.slice(0, -1).join(' ')}<span class="hm-num">{word.at(-1)}</span>
    </p>
    <h1>GTA 6 <span class="accent">100% completion</span> calculator</h1>
    <p class="lead">
      GTA 6 hides its 100% checklist until the story ends. Enter counts from your Progress menus to see what's left for all {
        data.totals.requirements
      } requirements and how many you can skip. Free, spoiler-safe, no account needed.
    </p>
    <p class="btn-row hero-actions">
      <a class="btn primary" href="#board">{r1.heroCta}</a>
      <a class="btn ghost" href={href('/card-sets/')}>Plan your card sets →</a>
    </p>
  </Planner>

  <DontLose client:load headingId="dont-lose" />

  <h2 id="checklist">All {data.totals.requirements} GTA 6 100% requirements</h2>
  <p class="prose">
    The full list of what you need and how many exist in the game—available now, without waiting for the story to end.
    Every figure is marked <em>verified</em> (two or more independent sources agree), <em>reported</em> (one original
    source), or <em>disputed</em> (sources conflict).
  </p>
  {
    data.categories.map((cat) => (
      <>
        <h3>{cat.name}</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Requirement</th>
                <th class="num">Needed</th>
                <th class="num">Total</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {data.requirements
                .filter((r) => r.categoryId === cat.id)
                .map((r) => (
                  <tr>
                    <td>{r.name}</td>
                    <td class="num">{fmt(r.unit, r.required)}</td>
                    <td class="num">{r.total === null ? '—' : fmt(r.unit, r.total)}</td>
                    <td>
                      <StatusBadge status={r.status} />
                    </td>
                  </tr>
                ))}
            </tbody>
          </table>
        </div>
      </>
    ))
  }

  <h2 id="how">How it works</h2>
  <div class="grid-4 steps">
    <div class="panel">
      <h3>1. Enter what the game shows</h3>
      <p class="muted">
        Before the story ends, your counts live across separate Progress menus. Enter the ones you have and leave the rest
        blank—blank means unknown, never zero.
      </p>
    </div>
    <div class="panel">
      <h3>2. See what's left and what you can skip</h3>
      <p class="muted">
        Each row shows how many you still need and how many of the rest you can skip. We don't show a made-up overall
        percentage because Rockstar hasn't published how requirements are weighted.
      </p>
    </div>
    <div class="panel">
      <h3>3. Plan your card sets</h3>
      <p class="muted">
        You only need {data.totals.cardSetsRequired} of {data.totals.cardSets} card sets. The <a href={href('/card-sets/')}>card set planner</a> picks
        the {data.totals.cardSetsRequired} sets that need the fewest extra cards from where you are now.
      </p>
    </div>
    <div class="panel">
      <h3>4. Don't lose anything</h3>
      <p class="muted">
        Pick your current chapter to see only what can be lost at the end of it—no plot details, no later chapters. Copy a
        share link anytime to move your progress to another device.
      </p>
    </div>
  </div>

  <h2 id="faq">Frequently asked questions</h2>
  {
    faqs.map((f) => (
      <details class="faq">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</Layout>
